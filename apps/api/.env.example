# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube a git.
#
# De dónde sale cada uno: docs/despliegue.md

# Conexión a Postgres de Supabase — usar la cadena del Session pooler, no la directa.
DATABASE_URL=

# Dirección del proyecto de Supabase.
SUPABASE_URL=

# Llave pública del proyecto (reemplaza a la antigua "anon key").
SUPABASE_PUBLISHABLE_KEY=

# Llave del servidor para Storage y para saltarse RLS (reemplaza a la antigua
# "service_role key"). Es secreta: nunca va en la web ni en la columna NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Para validar JWT de Supabase Auth localmente, sin llamar a su API en cada request.
SUPABASE_JWKS_URL=

# Dominios que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
